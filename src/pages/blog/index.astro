---
import Base from '../../layouts/Base.astro';
import {posts} from '../../lib/content.js';
---
<Base title="Blog" description="Writing on Elixir, software delivery, and design from the Optimum BH archive."><section class="wrap blog-index"><p class="eyebrow">The archive</p><h1>Lessons from the work.</h1><p class="intro">Writing on Elixir, software delivery, and design from the Optimum BH years.</p><div class="article-list">{posts.map(post => <a class="article-row" href={`/blog/${post.slug}/`}><time datetime={post.date.toISOString()}>{post.cardDate}</time><div><h2>{post.title}</h2><p>{post.author} · {post.reading_time} min read</p></div><span aria-hidden="true">↗</span></a>)}</div></section></Base>
