---
import {imageAttributes, articleImages} from '../../lib/images.js';
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import {posts} from '../../lib/content.js';
export function getStaticPaths() { return posts.map(post => ({params: {slug: post.slug}, props: {post}})); }
const {post} = Astro.props;
const hero = post.image ? await imageAttributes(post.image) : null;
const article = await articleImages(post.html);
// Hugo compares explicit Slug values; these posts have no explicit slug.
const related = posts.filter(item => item.explicitSlug !== post.explicitSlug).slice(0, 3);
---
<Base title={post.title} image={post.image} description={post.description}>
  {hero && <link slot="head" rel="preload" as="image" href={hero.src} fetchpriority="high" />}

<article>
  <section
    class="overlay-backdrop text-[1.65rem] leading-[1.75] md:leading-[2] content-grid"
  >
    <!-- Hero -->
    <div
      class="text-white text-lg h-[30vh] md:h-[35vh] blog-hero bg-cover bg-no-repeat"
      style={post.image ? `background-image: linear-gradient(rgba(103, 58, 183, 0.5), rgba(103, 58, 183, 0.5)), url('${hero.src}'); background-position: center 20%;` : undefined}
    >
      <div class="header-content grid content-end gap-y-2 pb-8">
        <h1 class="text-[2.75rem] font-bold">{post.title}</h1>

        <p class="md:text-xl order-last m-0 self-start">
          <span class="md:font-bold">By {post.author},</span><span class="md:hidden">&#32;</span><br class="hidden md:block" /><span>{post.role}</span>
        </p>

        <div class="mb-2 flex gap-x-4 order-first self-end">
          <p class="flex gap-x-2 items-center">
            <svg
              width="18"
              height="18"
              viewBox="0 0 16 16"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M8.00016 14.6667C11.6821 14.6667 14.6668 11.6819 14.6668 8C14.6668 4.3181 11.6821 1.33334 8.00016 1.33334C4.31826 1.33334 1.3335 4.3181 1.3335 8C1.3335 11.6819 4.31826 14.6667 8.00016 14.6667Z"
                stroke="white"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
              <path
                d="M8 4V8L10.6667 9.33333"
                stroke="white"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            <span>{post.reading_time} min read</span>
          </p>
          <p class="flex gap-x-2 items-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="17"
              viewBox="0 0 16 17"
              fill="currentColor"
            >
              <path
                d="M4.5384 0.5C4.68692 0.5 4.82936 0.559 4.93438 0.66402C5.0394 0.769041 5.0984 0.911479 5.0984 1.06V2.1072H11.112V1.0672C11.112 0.918679 11.171 0.776241 11.276 0.67122C11.381 0.5662 11.5235 0.5072 11.672 0.5072C11.8205 0.5072 11.963 0.5662 12.068 0.67122C12.173 0.776241 12.232 0.918679 12.232 1.0672V2.1072H14.4C14.8242 2.1072 15.2311 2.27566 15.5311 2.57555C15.8311 2.87543 15.9998 3.28219 16 3.7064V14.9008C15.9998 15.325 15.8311 15.7318 15.5311 16.0317C15.2311 16.3315 14.8242 16.5 14.4 16.5H1.6C1.17579 16.5 0.768947 16.3315 0.468912 16.0317C0.168877 15.7318 0.000212104 15.325 0 14.9008L0 3.7064C0.000212104 3.28219 0.168877 2.87543 0.468912 2.57555C0.768947 2.27566 1.17579 2.1072 1.6 2.1072H3.9784V1.0592C3.97861 0.910817 4.03771 0.768585 4.1427 0.663737C4.2477 0.55889 4.39002 0.5 4.5384 0.5ZM1.12 6.6936V14.9008C1.12 14.9638 1.13242 15.0263 1.15654 15.0845C1.18066 15.1427 1.21602 15.1956 1.26059 15.2402C1.30516 15.2848 1.35808 15.3201 1.41631 15.3443C1.47455 15.3684 1.53697 15.3808 1.6 15.3808H14.4C14.463 15.3808 14.5255 15.3684 14.5837 15.3443C14.6419 15.3201 14.6948 15.2848 14.7394 15.2402C14.784 15.1956 14.8193 15.1427 14.8435 15.0845C14.8676 15.0263 14.88 14.9638 14.88 14.9008V6.7048L1.12 6.6936ZM5.3336 12.1952V13.528H4V12.1952H5.3336ZM8.6664 12.1952V13.528H7.3336V12.1952H8.6664ZM12 12.1952V13.528H10.6664V12.1952H12ZM5.3336 9.0136V10.3464H4V9.0136H5.3336ZM8.6664 9.0136V10.3464H7.3336V9.0136H8.6664ZM12 9.0136V10.3464H10.6664V9.0136H12ZM3.9784 3.2264H1.6C1.53697 3.2264 1.47455 3.23882 1.41631 3.26294C1.35808 3.28706 1.30516 3.32242 1.26059 3.36699C1.21602 3.41156 1.18066 3.46448 1.15654 3.52271C1.13242 3.58095 1.12 3.64337 1.12 3.7064V5.5744L14.88 5.5856V3.7064C14.88 3.64337 14.8676 3.58095 14.8435 3.52271C14.8193 3.46448 14.784 3.41156 14.7394 3.36699C14.6948 3.32242 14.6419 3.28706 14.5837 3.26294C14.5255 3.23882 14.463 3.2264 14.4 3.2264H12.232V3.9696C12.232 4.11812 12.173 4.26056 12.068 4.36558C11.963 4.4706 11.8205 4.5296 11.672 4.5296C11.5235 4.5296 11.381 4.4706 11.276 4.36558C11.171 4.26056 11.112 4.11812 11.112 3.9696V3.2264H5.0984V3.9624C5.0984 4.11092 5.0394 4.25336 4.93438 4.35838C4.82936 4.4634 4.68692 4.5224 4.5384 4.5224C4.38988 4.5224 4.24744 4.4634 4.14242 4.35838C4.0374 4.25336 3.9784 4.11092 3.9784 3.9624V3.2264Z"
                fill="white"
              ></path>
            </svg>
            <time class="text-[12px] self-center"
              >{post.articleDate}</time
            >
          </p>
        </div>
      </div>
    </div>
    <!-- end blog hero -->

    <!-- Content + TOC -->
    <div class="py-14 blog-post-grid">
      <div class="blog-post-body"><span id="introduction"></span><Fragment set:html={article} /></div>

      <div class="hidden md:block py-5 px-6 border rounded-[1rem] shadow-lg shadow-[#b5ace3] table-of-contents">
        <h2 class="font-normal text-[2rem] leading-normal text-[#1D1D1D] mb-[2.375rem]">Contents</h2>
        <ul class="toc-list"><li><a href="#introduction">Introduction</a></li><Fragment set:html={post.toc} /></ul>
        <hr class="mt-[3.5rem] border-2 border-[#5337ff] opacity-30" />
        <p class="-mt-3 font-normal leading-[2em]">Contact us at</p>
        <div class="mt-3">
          <a href="mailto:projects@optimum.ba" class="font-normal leading-[2em] underline decoration-1 text-[#5337FF]" target="_blank" rel="noreferrer">projects@optimum.ba</a>
        </div>
      </div>
    </div>
  </section>

  <!-- More articles -->
  {related.length > 0 && (
  <div class="content-grid pb-16">
    <h3
      class="font-semibold tracking-wide text-[2.275rem] before:content-[''] before:opacity-75 before:my-16 before:block before:h-[0.125rem] before:bg-[#5337ff] before:w-full"
    >
      More articles
    </h3>
    <div class="more-articles">
      {related.map(item => <BlogCard post={item} />)}
    </div>
  </div>
  )}
</article>

</Base>