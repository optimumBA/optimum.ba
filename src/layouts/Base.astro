---
import '../../static/css/app.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const {home = false, title = '', image, description = 'Full-stack software development agency specializing in the PETAL stack — Phoenix, Elixir, TailwindCSS, Alpine.js, LiveView.'} = Astro.props;
const analytics = import.meta.env.PROD && (!process.env.CF_PAGES_BRANCH || process.env.CF_PAGES_BRANCH === 'main');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    {home && <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'WebSite', name: 'Optimum', url: 'https://optimum.ba/'
    })} />}
    <title>{home ? "Optimum" : `${title} — Optimum`}</title>
    <meta
      name="description"
      content={description}
    />
    <meta property="og:description" content={description} />
    {!home && <meta property="og:title" content={title} />}
    {image && <meta property="og:image" content={image} />}
    <link rel="preload" href="/fonts/montserrat-6438d7b8ea9c.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/images/favicon-180x180.png" />
    <slot name="head" />
  </head>

  <body class="font-montserrat">
    <Nav />
    <main><slot /></main>
    <Footer />
    <script is:inline src="/js/app.js"></script>
    {analytics && <script is:inline defer src="/js/analytics.js"></script>}
  </body>
</html>
