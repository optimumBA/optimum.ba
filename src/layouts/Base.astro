---
import '../styles/brand.css';
const {home = false, title = '', image, description = 'Software development and product consulting. Optimum Tech helps businesses decide what to build, develop the software, and put it to work.'} = Astro.props;
const analytics = import.meta.env.PROD && (!process.env.CF_PAGES_BRANCH || process.env.CF_PAGES_BRANCH === 'main');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{home ? 'Optimum Tech — Software development and product consulting' : `${title} — Optimum Tech`}</title>
<meta name="description" content={description} /><meta property="og:title" content={home ? 'Optimum Tech' : title} /><meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
{home && <script is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:'Optimum Tech',url:'https://optimum.ba/'})} />}
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon.ico" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title="Optimum Tech blog" href="/blog/index.xml" /><slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header wrap"><a class="logo" href="/" aria-label="Optimum Tech home"><img src="/brand/optimum-logo-cobalt.svg" width="240" height="60" alt="Optimum Tech" /></a><nav aria-label="Main navigation"><a href="/#work">Our work</a><a href="/blog/">Blog</a><a href="mailto:almir@optimum.ba">Get in touch <span aria-hidden="true">↗</span></a></nav></header>
<main id="main"><slot /></main>
<footer class="wrap site-footer"><a href="/" class="footer-name">Optimum Tech</a><span>© {new Date().getFullYear()} Optimum Tech, LLC</span><div><a href="https://github.com/optimumBA">GitHub</a><a href="https://x.com/optimumBA">X</a><a href="/blog/index.xml">RSS</a></div></footer>
{analytics && <script is:inline defer src="/js/analytics.js"></script>}
</body></html>
