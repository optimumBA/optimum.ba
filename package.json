{
  "name": "optimum-landing",
  "private": true,
  "scripts": {
    "build": "npm run setup:syntax && npm run build:css && astro build",
    "build:css": "tailwindcss -i ./assets/css/app.css -o ./static/css/app.css --minify",
    "dev": "npm run setup:syntax && concurrently \"npm run watch:css\" \"astro dev\"",
    "serve": "npm run dev",
    "watch:css": "tailwindcss -i ./assets/css/app.css -o ./static/css/app.css --watch",
    "preview": "astro preview",
    "setup:syntax": "node scripts/setup-chroma.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/cli": "^4.0.0",
    "astro": "7.3.2",
    "cheerio": "1.2.0",
    "concurrently": "9.2.4",
    "gray-matter": "4.0.3",
    "markdown-it": "15.0.1",
    "tailwindcss": "^4.0.0"
  },
  "type": "module"
}
